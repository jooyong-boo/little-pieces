EXPO_PUBLIC_API_URL=http://localhost:3000

# Android 지도용 Google Maps API 키. 없으면 Android에서만 지도가 회색으로 뜬다.
# iOS는 Apple Maps를 쓰므로 키가 필요 없다.
# APK에 그대로 박히는 공개 키다 — Google Cloud 콘솔에서 패키지명(com.littlepieces.app)과
# debug.keystore의 SHA-1로 애플리케이션 제한을 반드시 걸어야 한다.
# EAS 빌드에서는 같은 이름의 시크릿을 등록해야 한다.
GOOGLE_MAPS_ANDROID_KEY=
